# All optional — each integration falls back gracefully when unset.
MONGODB_URI=            # Atlas sandbox connection string
MONGODB_DB=fitgate
VOYAGE_API_KEY=
VOYAGE_BASE_URL=        # Atlas AI Model API keys: https://us.ai.mongodb.com/v1 (direct Voyage keys: leave empty)
ANTHROPIC_API_KEY=       # paid; used first if set
# Free fallbacks (first one set wins): Gemini → Groq → Cerebras
GEMINI_API_KEY=          # aistudio.google.com/apikey
GROQ_API_KEY=
CEREBRAS_API_KEY=
LLM_MODEL=               # optional model override for the free provider
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=    # optional, defaults to a stock voice
